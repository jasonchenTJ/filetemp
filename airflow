import requests

def get_airflow_token(base_url, username, password):
    resp = requests.post(
        f"{base_url}/auth/token",
        json={"username": username, "password": password}
    )
    resp.raise_for_status()
    return resp.json()["access_token"]

# 获取 token
token = get_airflow_token("http://localhost:8080", "your-username", "your-password")

# 调用业务 API
headers = {"Authorization": f"Bearer {token}"}
resp = requests.get("http://localhost:8080/api/v2/dags", headers=headers)
print(resp.json())